@@ -96,38 +88,45 @@ def _canonical_json_bytes(value: object) -> bytes:
 
 def _canonical_decimal_text(value: Decimal) -> str:
     if value.is_zero():
         return "0"
     rendered = format(value, "f")
     if "." in rendered:
         rendered = rendered.rstrip("0").rstrip(".")
     return rendered
 
 
