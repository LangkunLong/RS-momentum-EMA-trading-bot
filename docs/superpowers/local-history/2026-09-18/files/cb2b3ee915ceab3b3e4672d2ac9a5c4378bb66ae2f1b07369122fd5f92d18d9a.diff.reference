+@dataclass(frozen=True, slots=True)
+class TerminalAuditReceipt:
+    """AuditTrail-authenticated identity for one immutable terminal provider event."""
+
+    audit_run_id: str
+    run_manifest_sha256: str
+    call_index: int
+    iteration: int
