 def _v4_focus_areas(value: object, field: str) -> tuple[str, ...]:
-    parsed = _v4_response_list(value, field, allow_empty=False, max_items=3)
-    parsed = tuple(
-        item.casefold().replace("-", "_").replace(" ", "_") for item in parsed
