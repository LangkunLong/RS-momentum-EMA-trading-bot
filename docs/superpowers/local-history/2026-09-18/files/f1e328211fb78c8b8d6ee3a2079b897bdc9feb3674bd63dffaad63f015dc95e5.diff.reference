+        reserved_audit_sha256 = str(reserved_event["event_sha256"])
+
+        def provider_facts(
+            *,
+            outcome: str,
+            request_started: bool,
+            response_received: bool,
+            returned_model: str | None,
+            finish_reason: str | None,
+            response_schema_valid: bool,
