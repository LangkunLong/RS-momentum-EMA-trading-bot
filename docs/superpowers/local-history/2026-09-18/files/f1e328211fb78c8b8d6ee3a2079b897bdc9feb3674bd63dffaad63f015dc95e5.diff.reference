+            raise
+        started_audit_sha256 = str(started_event["event_sha256"])
+        messages = [
+            {
+                "role": "system",
+                "content": PIT_OPTIMIZER_V2_SYSTEM_PROMPTS[role],
+            },
+            {"role": "user", "content": dynamic_bytes.decode("utf-8")},
