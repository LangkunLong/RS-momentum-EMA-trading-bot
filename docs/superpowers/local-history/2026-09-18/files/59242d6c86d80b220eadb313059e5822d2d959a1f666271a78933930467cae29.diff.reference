--- a/core/pit_optimization_contract.py
+++ b/core/pit_optimization_contract.py
@@ -419,26 +419,41 @@ def _bounds_fit(inner: PatchBounds, outer: PatchBounds) -> bool:
     )
 
 
 def _validate_scoped_paths_symbols(
     paths: tuple[str, ...],
     symbols: tuple[str, ...],
     label: str,
