+def native_python_alias_identity() -> dict[str, object]:
+    status = os.lstat(PYTHON_NATIVE_ALIAS)
+    attributes = getattr(status, "st_file_attributes", None)
+    reparse_tag = getattr(status, "st_reparse_tag", None)
+    if (
+        status.st_size != 0
+        or attributes != PYTHON_ALIAS_FILE_ATTRIBUTES
+        or reparse_tag != PYTHON_ALIAS_REPARSE_TAG
+        or not attributes & _REPARSE_POINT
+    ):
+        raise RuntimeError("native Python app alias metadata differs from reviewed launcher evidence")
+    return {
+        "path": str(PYTHON_NATIVE_ALIAS),
+        "size_bytes": status.st_size,
+        "file_attributes": attributes,
+        "reparse_tag": reparse_tag,
+        "content_sha256": None,
+        "content_hash_claimed": False,
+    }
+
