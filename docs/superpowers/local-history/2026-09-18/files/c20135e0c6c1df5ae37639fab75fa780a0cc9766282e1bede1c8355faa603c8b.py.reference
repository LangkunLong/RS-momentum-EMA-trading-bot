"""Development hypothesis: lower the composite floor with all other gates retained."""

from __future__ import annotations

from core.strategy_policy.contracts import EntryDecision
from core.strategy_policy.contracts_v3 import EntrySnapshotV3
from core.strategy_policy.entry import evaluate_entry as _evaluate_entry_v2


def evaluate_entry(snapshot: EntrySnapshotV3) -> EntryDecision:
    """Apply baseline gates with the composite-score floor lowered to 60."""
    decision = _evaluate_entry_v2(snapshot.base)
    score = snapshot.base.entry_composite_score
    blocking_codes = decision.blocking_codes
    # The pinned baseline appends its composite gate last, after all other gates.
    if (
        not snapshot.base.technical_only
        and score is not None
        and 60.0 <= score < 70.0
        and blocking_codes
        and blocking_codes[-1] == "composite_score_below_threshold"
    ):
        blocking_codes = blocking_codes[:-1]
    return EntryDecision(
        qualified=not blocking_codes,
        market_permitted=decision.market_permitted,
        rank=decision.rank,
        blocking_codes=blocking_codes,
    )


__all__ = ("evaluate_entry",)
