"""Bind a controller-authored artifact to an actual pending role and import it."""
import argparse
import json
from pathlib import Path
import subprocess
import sys

parser = argparse.ArgumentParser()
parser.add_argument('--root', required=True, type=Path)
parser.add_argument('--pending-result', required=True, type=Path)
parser.add_argument('--artifact', required=True, type=Path)
parser.add_argument('--label', required=True)
args = parser.parse_args()
root = args.root.resolve()
if not args.label.replace('-', '').isalnum():
    raise ValueError('Use a plain receipt label')
saved = json.loads((root / 'campaign-launch-input.json').read_text())
result = json.loads(args.pending_result.read_text())
if result['status'] != 'pending_controller_response' or result['manifest_ref'] != saved['manifest_ref']:
    raise ValueError('An actual pending response for this manifest is required')
pending = result['pending']
request = json.loads((root / pending['request_ref']['relative_path']).read_text())['request']
artifact = json.loads(args.artifact.read_text())
envelope = {
    'schema_version': 5,
    'artifact_type': 'controller_role_response',
    'call_key_sha256': pending['call_key_sha256'],
    'request_sha256': pending['request_sha256'],
    'response': {'artifact': artifact, 'binding': request['expected_binding']},
}
response_file = root / (args.label + '-response.json')
with response_file.open('x') as stream:
    json.dump(envelope, stream, indent=2)
command = [sys.executable, '-B', '-m', 'core.pit_optimizer_v5.cli', 'controller-response',
           '--artifact-root', str(root), '--manifest-path', saved['manifest_ref']['relative_path'],
           '--manifest-sha256', saved['manifest_ref']['sha256'],
           '--request-path', pending['request_ref']['relative_path'],
           '--request-sha256', pending['request_ref']['sha256'], '--response-file', str(response_file)]
completed = subprocess.run(command, capture_output=True, text=True)
with (root / (args.label + '-import-stdout.txt')).open('x') as stream:
    stream.write(completed.stdout)
with (root / (args.label + '-import-stderr.txt')).open('x') as stream:
    stream.write(completed.stderr)
print(completed.stdout, flush=True)
if completed.stderr:
    print(completed.stderr, file=sys.stderr, flush=True)
sys.exit(completed.returncode)
