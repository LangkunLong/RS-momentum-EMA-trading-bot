"""Local operator build using only the declared evaluator source closure."""
from pathlib import Path
import hashlib
import json
import subprocess
from core.pit_optimizer_v5.contracts import EVALUATOR_SOURCE_PATHS_V5, evaluator_source_map_v5, evaluator_source_sha256

root = Path.cwd()
source_map = evaluator_source_map_v5(root)
runtime_sha = evaluator_source_sha256(source_map)
stage = root / '.superpowers/sdd/2026-09-04-pit-optimizer-v5-campaign' / ('evaluator-build-context-' + runtime_sha[:12])
recipe_paths = ('Dockerfile.pit-optimizer-v5', 'Dockerfile.pit-optimizer-v5.dockerignore', 'requirements-lock.txt')
paths = tuple(sorted((*EVALUATOR_SOURCE_PATHS_V5, *recipe_paths)))
if not stage.exists():
    stage.mkdir()
    for relative in paths:
        target = stage / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        with target.open('xb') as f:
            f.write((root / relative).read_bytes())
actual = tuple(sorted(p.relative_to(stage).as_posix() for p in stage.rglob('*') if p.is_file()))
if actual != paths:
    raise ValueError('Staged build file set differs from exact declared evaluator closure')
for relative in paths:
    if (stage / relative).read_bytes() != (root / relative).read_bytes():
        raise ValueError('Existing staged bytes differ; do not overwrite immutable build context')
if evaluator_source_sha256(evaluator_source_map_v5(stage)) != runtime_sha:
    raise ValueError('Staged source identity mismatch')
build_dir = root / '.artifacts/pit-optimizer-v5/evaluator/builds' / runtime_sha[:12]
build_dir.mkdir(parents=True, exist_ok=False)
inventory = {'runtime_source_sha256': runtime_sha, 'file_count': len(paths), 'files': {path: {'sha256': hashlib.sha256((stage / path).read_bytes()).hexdigest(), 'bytes': (stage / path).stat().st_size} for path in paths}}
(build_dir / 'context-inventory.json').write_text(json.dumps(inventory, indent=2) + '\n', encoding='utf-8')
tag = 'pit-optimizer-v5-evaluator:source-' + runtime_sha[:12]
argv = ['docker', '--context', 'desktop-linux', 'buildx', 'build', '--builder', 'desktop-linux', '--load', '--progress', 'plain', '--file', str(stage / 'Dockerfile.pit-optimizer-v5'), '--build-arg', 'PIT_V5_RUNTIME_SOURCE_SHA256=' + runtime_sha, '--tag', tag, '--metadata-file', str(build_dir / 'build-metadata.json'), '--iidfile', str(build_dir / 'image-id.txt'), str(stage)]
(build_dir / 'build-argv.json').write_text(json.dumps(argv, indent=2) + '\n', encoding='utf-8')
print(json.dumps({'state': 'building', 'runtime_source_sha256': runtime_sha, 'exact_context_files': len(paths), 'build_dir': str(build_dir)}), flush=True)
with (build_dir / 'build.log').open('x', encoding='utf-8') as log:
    result = subprocess.run(argv, stdout=log, stderr=subprocess.STDOUT, timeout=900)
if result.returncode:
    raise ValueError('Local evaluator build failed; inspect recorded build.log')
inspect = json.loads(subprocess.run(['docker', 'image', 'inspect', tag], capture_output=True, text=True, check=True, timeout=30).stdout)[0]
if inspect.get('Config', {}).get('Labels', {}).get('io.trading-bot.pit-v5.runtime-source-sha256') != runtime_sha:
    raise ValueError('Built image source label differs')
digests = [value for value in inspect.get('RepoDigests', []) if value.startswith('pit-optimizer-v5-evaluator@sha256:')]
if len(digests) != 1:
    raise ValueError('Expected one actual local immutable RepoDigest')
record = {'image_reference': digests[0], 'image_id': inspect['Id'], 'runtime_source_sha256': runtime_sha, 'tag': tag, 'context_inventory_sha256': hashlib.sha256((build_dir / 'context-inventory.json').read_bytes()).hexdigest(), 'scope': 'local_evaluator_image_build_only', 'remote_registry_push': False}
(build_dir / 'image-record.json').write_text(json.dumps(record, indent=2) + '\n', encoding='utf-8')
print(json.dumps(record), flush=True)
