+@dataclass(frozen=True, slots=True)
+class MarketContextV1(_CanonicalContract):
+    schema_version: int
+    session: str
+    oneil_regime: str
+    distribution_days: int
+    follow_through: bool
+    benchmarks: tuple[BenchmarkContextV1, ...]
