+            "2" * 64,
+            "--verified-parity",
+            str(absolute / "parity.json"),
+            "--verified-parity-sha256",
+            "3" * 64,
+            "--optimizer-authorization-requirement-sha256",
+            "4" * 64,
+            "--max-usd",
+            "0.40",
