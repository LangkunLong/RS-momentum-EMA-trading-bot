"""Prepare the reviewed native C-c campaign package without launching it.

This driver is reserved for principal execution after final source, script, and
updated-readiness approval.  It creates immutable preparation artifacts and one
nonpersisting round-1 investigator preview.  It never enrolls or starts a
campaign, persists a role request, reserves a role slot, resolves credentials,
or invokes a provider, evaluator, container, or Docker.
"""

from __future__ import annotations

