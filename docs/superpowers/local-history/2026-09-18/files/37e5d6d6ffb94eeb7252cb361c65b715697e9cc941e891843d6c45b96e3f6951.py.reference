from __future__ import annotations

import ast
import difflib
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path


ROOT = Path.cwd()
sys.path.insert(0, str(ROOT))
PACKAGE = ROOT / ".artifacts/pit-optimizer-v5/development/increment-c-history-h3"
SOURCE = ROOT / "core/pit_optimizer_v5/production_provider.py"
PREIMAGE = PACKAGE / "pre-h3b-production_provider.py"
RUNTIME = ROOT / ".artifacts/pit-optimizer-v5/development/runtime-04"
PROVIDER = ROOT / ".artifacts/pit-optimizer-v5/development/provider-runtime-06"


def digest(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def write_json(name: str, value: object) -> None:
    (PACKAGE / name).write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def extended_root(path: Path) -> str:
    absolute = str(path.resolve())
    if os.name != "nt" or absolute.startswith("\\\\?\\"):
        raise RuntimeError("H3b archive evidence requires a non-extended Windows root")
    value = f"\\\\?\\{absolute}"
    if not value.startswith("\\\\?\\"):
        raise RuntimeError("extended Windows root assertion failed")
    return value


def archive_map(path: Path) -> dict[str, object]:
    root = extended_root(path)
    files: dict[str, dict[str, object]] = {}
    for directory, directories, names in os.walk(root):
        directories.sort()
        for name in sorted(names):
            absolute = os.path.join(directory, name)
            relative = os.path.relpath(absolute, root).replace(os.sep, "/")
            with open(absolute, "rb") as handle:
                raw = handle.read()
            files[relative] = {"sha256": digest(raw), "bytes": len(raw)}
    files = dict(sorted(files.items()))
    tree = digest(json.dumps(files, ensure_ascii=False, separators=(",", ":")).encode("utf-8"))
    return {
        "archive_root": path.relative_to(ROOT).as_posix(),
        "extended_root": root,
        "extended_root_asserted": root.startswith("\\\\?\\"),
        "file_count": len(files),
        "byte_count": sum(int(item["bytes"]) for item in files.values()),
        "tree_sha256": tree,
        "canonicalization": "sorted ordinal relative path keys; compact UTF-8 JSON object of sha256 and byte count",
        "files": files,
    }


def before() -> None:
    raw = SOURCE.read_bytes()
    if digest(raw) != "8fbb630fbc5f28b907cf7c8134d32219fc353a8436ec74d65e4a97f83e51f545":
        raise RuntimeError("H3b production-provider preimage differs")
    PREIMAGE.write_bytes(raw)
    runtime = archive_map(RUNTIME)
    provider = archive_map(PROVIDER)
    if runtime["file_count"] != 579 or provider["file_count"] != 83:
        raise RuntimeError("archive file count differs from the sealed scope")
    write_json("h3b-runtime-04-before.json", runtime)
    write_json("h3b-provider-runtime-06-before.json", provider)
    print(digest(raw), len(raw))
    print(runtime["file_count"], runtime["tree_sha256"])
    print(provider["file_count"], provider["tree_sha256"])


def definitions(raw: bytes) -> tuple[dict[str, bytes], dict[str, ast.FunctionDef]]:
    tree = ast.parse(raw)
    lines = raw.splitlines(keepends=True)
    values: dict[str, bytes] = {}
    nodes: dict[str, ast.FunctionDef] = {}
    for node in tree.body:
        if isinstance(node, ast.FunctionDef):
            values[node.name] = b"".join(lines[node.lineno - 1 : node.end_lineno])
            nodes[node.name] = node
        elif isinstance(node, ast.ClassDef):
            for child in node.body:
                if isinstance(child, ast.FunctionDef):
                    name = f"{node.name}.{child.name}"
                    values[name] = b"".join(lines[child.lineno - 1 : child.end_lineno])
                    nodes[name] = child
    return values, nodes


def call_name(node: ast.Call) -> str | None:
    if isinstance(node.func, ast.Name):
        return node.func.id
    if isinstance(node.func, ast.Attribute):
        return node.func.attr
    return None


class _ExtractedContext(ast.NodeTransformer):
    def visit_Call(self, node: ast.Call) -> ast.AST:
        if isinstance(node.func, ast.Attribute) and isinstance(node.func.value, ast.Name) and node.func.value.id == "self":
            replacements = {
                "_conservative_unreported_usage": ("_conservative_unreported_usage_v5", [ast.Name(id="manifest")]),
                "_completion_usage": ("_completion_usage_v5", [ast.Name(id="manifest")]),
                "_derive_reported_terminal": (
                    "_derive_reported_terminal_v5",
                    [],
                ),
                "_verify_terminal_facts": ("_verify_terminal_facts_v5", []),
            }
            replacement = replacements.get(node.func.attr)
            if replacement is not None:
                name, leading_args = replacement
                keywords = list(node.keywords)
                if node.func.attr == "_derive_reported_terminal":
                    keywords = [
                        ast.keyword(arg="manifest", value=ast.Name(id="manifest")),
                        ast.keyword(arg="identity", value=ast.Name(id="identity")),
                        *keywords,
                    ]
                elif node.func.attr == "_verify_terminal_facts":
                    keywords = [
                        ast.keyword(arg="repository", value=ast.Name(id="repository")),
                        ast.keyword(arg="manifest", value=ast.Name(id="manifest")),
                        ast.keyword(arg="identity", value=ast.Name(id="identity")),
                        *keywords,
                    ]
                return self.generic_visit(
                    ast.Call(func=ast.Name(id=name), args=[*leading_args, *node.args], keywords=keywords)
                )
        return self.generic_visit(node)

    def visit_Attribute(self, node: ast.Attribute) -> ast.AST:
        if isinstance(node.value, ast.Name) and node.value.id == "self":
            direct = {
                "_manifest": ast.Name(id="manifest"),
                "_repository": ast.Name(id="repository"),
                "campaign_manifest_sha256": ast.Attribute(
                    value=ast.Name(id="identity"), attr="campaign_manifest_sha256"
                ),
                "audit_store_identity_sha256": ast.Attribute(
                    value=ast.Name(id="identity"), attr="audit_store_identity_sha256"
                ),
                "ledger_identity_sha256": ast.Attribute(value=ast.Name(id="identity"), attr="ledger_identity_sha256"),
            }
            replacement = direct.get(node.attr)
            if replacement is not None:
                return replacement
        return self.generic_visit(node)


def normalized_body(node: ast.FunctionDef, *, extracted: bool) -> str:
    body = ast.Module(body=node.body, type_ignores=[])
    if extracted:
        body = _ExtractedContext().visit(body)  # type: ignore[assignment]
    return ast.dump(ast.fix_missing_locations(body), include_attributes=False)


def static() -> None:
    pre_raw = PREIMAGE.read_bytes()
    raw = SOURCE.read_bytes()
    pre_values, pre_nodes = definitions(pre_raw)
    values, nodes = definitions(raw)
    changed = {
        name for name in set(pre_values) & set(values) if pre_values[name] != values[name]
    }
    added = set(values) - set(pre_values)
    removed = set(pre_values) - set(values)
    delegated = {
        "LocalRoleAuthorizationLedgerV5._conservative_unreported_usage",
        "LocalRoleAuthorizationLedgerV5._completion_usage",
        "LocalRoleAuthorizationLedgerV5._derive_reported_terminal",
        "LocalRoleAuthorizationLedgerV5._verify_terminal_facts",
        "LocalRoleAuthorizationLedgerV5._load_verified",
        "LocalRoleAuthorizationLedgerV5.authenticate_role_invocations",
    }
    extraction_pairs = {
        "LocalRoleAuthorizationLedgerV5._conservative_unreported_usage": "_conservative_unreported_usage_v5",
        "LocalRoleAuthorizationLedgerV5._completion_usage": "_completion_usage_v5",
        "LocalRoleAuthorizationLedgerV5._derive_reported_terminal": "_derive_reported_terminal_v5",
        "LocalRoleAuthorizationLedgerV5._verify_terminal_facts": "_verify_terminal_facts_v5",
        "LocalRoleAuthorizationLedgerV5._load_verified": "_load_verified_role_ledger_v5",
        "LocalRoleAuthorizationLedgerV5.authenticate_role_invocations": "_authenticate_role_invocations_v5",
    }
    extraction_equal = {
        old: normalized_body(pre_nodes[old], extracted=True) == normalized_body(nodes[new], extracted=False)
        for old, new in extraction_pairs.items()
    }
    old_auth = ast.FunctionDef(
        name="authenticate_role_invocations",
        args=pre_nodes["LocalRoleAuthorizationLedgerV5.authenticate_role_invocations"].args,
        body=[
            *pre_nodes["LocalRoleAuthorizationLedgerV5.authenticate_role_invocations"].body[:2],
            *pre_nodes["LocalRoleAuthorizationLedgerV5.authenticate_role_invocations"].body[3:],
        ],
        decorator_list=[],
    )
    extraction_equal["LocalRoleAuthorizationLedgerV5.authenticate_role_invocations"] = normalized_body(
        old_auth, extracted=True
    ) == normalized_body(nodes["_authenticate_role_invocations_v5"], extracted=False)
    protected = sorted(set(pre_values) - delegated)
    protected_hashes = {
        name: {
            "before": digest(pre_values[name]),
            "after": digest(values[name]),
            "unchanged": pre_values[name] == values[name],
        }
        for name in protected
    }
    read_functions = [
        "_role_ledger_read_identity_v5",
        "_conservative_unreported_usage_v5",
        "_completion_usage_v5",
        "_derive_reported_terminal_v5",
        "_verify_terminal_facts_v5",
        "_load_verified_role_ledger_v5",
        "_authenticate_role_invocations_v5",
        "authenticate_paid_role_history_v5",
    ]
    callgraph = {
        name: sorted(
            {
                call_name(child)
                for child in ast.walk(nodes[name])
                if isinstance(child, ast.Call) and call_name(child) is not None
            }
        )
        for name in read_functions
    }
    forbidden = {
        "LocalRoleAuthorizationLedgerV5",
        "OpenRouterOneShotJsonCompletionV5",
        "append_role_ledger_reservation",
        "append_role_ledger_terminal",
        "append_role_provider_response",
        "load_typed_state",
        "recover_typed_state_index",
        "reserve_role_slot",
        "publish_role_provider_response",
        "settle_role_slot",
        "settle_unreported_role_slot",
        "recover_role_slot",
        "reconcile_paid_role",
        "role_provider_transition",
        "_now_ms",
        "token_hex",
        "time_ns",
    }
    forbidden_calls = sorted({call for calls in callgraph.values() for call in calls if call in forbidden})
    forbidden_names = sorted(
        {
            child.id
            for name in read_functions
            for child in ast.walk(nodes[name])
            if isinstance(child, ast.Name) and child.id in {"os", "secrets", "time"}
        }
    )
    repository_calls = sorted(
        {
            child.func.attr
            for name in read_functions
            for child in ast.walk(nodes[name])
            if isinstance(child, ast.Call)
            and isinstance(child.func, ast.Attribute)
            and isinstance(child.func.value, ast.Name)
            and child.func.value.id == "repository"
        }
    )
    accepted = json.loads((PACKAGE / "h3a-evaluator-source-map.json").read_text(encoding="utf-8"))
    source_map = {path: digest((ROOT / path).read_bytes()) for path in accepted["source_sha256_by_path"]}
    evaluator = {
        "count": len(source_map),
        "sha256": __import__("core.pit_optimizer_v5.contracts", fromlist=["canonical_sha256_v5"]).canonical_sha256_v5(
            source_map
        ),
        "source_sha256_by_path": source_map,
    }
    checks = {
        "only_six_existing_read_methods_changed": changed == delegated,
        "no_existing_definition_removed": not removed,
        "exact_expected_functions_added": added
        == {
            "_role_ledger_read_identity_v5",
            "_conservative_unreported_usage_v5",
            "_completion_usage_v5",
            "_derive_reported_terminal_v5",
            "_verify_terminal_facts_v5",
            "_load_verified_role_ledger_v5",
            "_authenticate_role_invocations_v5",
            "authenticate_paid_role_history_v5",
        },
        "all_six_algorithms_extracted_exactly": all(extraction_equal.values()),
        "all_constructor_gateway_lifecycle_and_other_methods_byte_identical": all(
            item["unchanged"] for item in protected_hashes.values()
        ),
        "read_path_has_no_operational_write_nonce_clock_or_environment_access": not forbidden_calls
        and not forbidden_names,
        "repository_calls_are_exact_immutable_allowlist": repository_calls
        == [
            "load_role_ledger_records",
            "load_role_provider_response",
            "load_unique_role_request_by_sha256",
            "load_unique_role_request_entry_by_sha256",
        ],
        "source_newline_style_is_preserved_crlf": raw.count(b"\r\n") == raw.count(b"\n") == 1212,
        "evaluator_closure_is_56_files": len(source_map) == 56,
        "evaluator_digest_is_fixed": evaluator["sha256"]
        == "005064e57e80840f3b2a97d7db694b176832b8f982996e63efc8a35064505ed4",
        "evaluator_files_are_unchanged": source_map == accepted["source_sha256_by_path"],
    }
    evidence = {
        "pass": all(checks.values()),
        "checks": checks,
        "definition_changes": {"added": sorted(added), "changed": sorted(changed), "removed": sorted(removed)},
        "extraction_body_equality": extraction_equal,
        "protected_definition_hashes": protected_hashes,
        "read_callgraph": callgraph,
        "repository_calls": repository_calls,
        "forbidden_calls": forbidden_calls,
        "forbidden_names": forbidden_names,
        "source_hashes": {
            "preimage": {"sha256": digest(pre_raw), "bytes": len(pre_raw)},
            "source": {"sha256": digest(raw), "bytes": len(raw)},
        },
        "evaluator": {"count": evaluator["count"], "sha256": evaluator["sha256"]},
    }
    write_json("h3b-static-verification.json", evidence)
    write_json("h3b-source-hashes.json", evidence["source_hashes"])
    write_json("h3b-evaluator-source-map.json", evaluator)
    diff = difflib.unified_diff(
        pre_raw.decode("utf-8").splitlines(keepends=True),
        raw.decode("utf-8").splitlines(keepends=True),
        fromfile="a/core/pit_optimizer_v5/production_provider.py.pre-h3b",
        tofile="b/core/pit_optimizer_v5/production_provider.py",
    )
    (PACKAGE / "h3b-source.diff").write_text("".join(diff), encoding="utf-8", newline="")
    print(json.dumps(evidence, indent=2, sort_keys=True))
    if not evidence["pass"]:
        raise SystemExit(1)


def snapshots(suffix: str) -> None:
    runtime = archive_map(RUNTIME)
    provider = archive_map(PROVIDER)
    if runtime["file_count"] != 579 or provider["file_count"] != 83:
        raise RuntimeError("archive file count differs from the sealed scope")
    write_json(f"h3b-runtime-04-{suffix}.json", runtime)
    write_json(f"h3b-provider-runtime-06-{suffix}.json", provider)
    print(runtime["file_count"], runtime["tree_sha256"])
    print(provider["file_count"], provider["tree_sha256"])


def preservation() -> None:
    comparisons = {}
    for key, prefix in (("runtime_04", "runtime-04"), ("provider_runtime_06", "provider-runtime-06")):
        before_map = json.loads((PACKAGE / f"h3b-{prefix}-before.json").read_text(encoding="utf-8"))
        after_map = json.loads((PACKAGE / f"h3b-{prefix}-after.json").read_text(encoding="utf-8"))
        changed = sorted(
            path
            for path in set(before_map["files"]) | set(after_map["files"])
            if before_map["files"].get(path) != after_map["files"].get(path)
        )
        comparisons[key] = {
            "before_file_count": before_map["file_count"],
            "after_file_count": after_map["file_count"],
            "before_byte_count": before_map["byte_count"],
            "after_byte_count": after_map["byte_count"],
            "before_tree_sha256": before_map["tree_sha256"],
            "after_tree_sha256": after_map["tree_sha256"],
            "extended_roots_asserted": before_map["extended_root_asserted"] and after_map["extended_root_asserted"],
            "changed_paths": changed,
            "unchanged": not changed,
        }
    evidence = {**comparisons, "pass": all(item["unchanged"] for item in comparisons.values())}
    write_json("h3b-preservation-check.json", evidence)
    print(json.dumps(evidence, indent=2, sort_keys=True))
    if not evidence["pass"]:
        raise SystemExit(1)


def authenticate_actual() -> None:
    from core.pit_optimizer_v5.artifacts import LocalArtifactRepositoryV5
    from core.pit_optimizer_v5.contracts import ArtifactRefV5, CampaignManifestV5
    from core.pit_optimizer_v5.development_preparation import ProviderDevelopmentAdapterConfigV5
    from core.pit_optimizer_v5.memory import RoleCompletionPayloadV5, RoundOutcomePayloadV5
    from core.pit_optimizer_v5.operations import CampaignLaunchV5
    from core.pit_optimizer_v5.production_provider import (
        _role_ledger_read_identity_v5,
        authenticate_paid_role_history_v5,
    )
    from core.pit_optimizer_v5.provider import LedgerRoleTerminalAuthorityV5

    manifest_ref = ArtifactRefV5(
        "campaigns/development-provider-two-rounds-20260907-06/manifest.json",
        "d90ed717c0d6b34d4cfa6bf7e2dd1f753e68c43b1127b200a66d2a9f930dfdf6",
    )
    repository = LocalArtifactRepositoryV5(PROVIDER.resolve())
    manifest = repository.load_typed_artifact(manifest_ref, value_type=CampaignManifestV5)
    launch = repository.load_typed_state(
        namespace="campaign-launch",
        key=manifest.sha256,
        value_type=CampaignLaunchV5,
        repair=False,
    )
    if launch is None or launch.manifest_ref != manifest_ref:
        raise RuntimeError("actual06 original campaign launch is absent or different")
    config = repository.load_typed_artifact(
        launch.adapter_config_ref,
        value_type=ProviderDevelopmentAdapterConfigV5,
    )
    packages = []
    rounds = []
    round_outcomes = []
    for round_index in range(1, manifest.search.max_feedback_rounds + 1):
        round_packages = []
        for event in repository.load_round_events(campaign_id=manifest.campaign_id, round_index=round_index):
            payload = repository.load_round_payload(event.payload_ref, expected_kind=event.event_kind)
            if type(payload) is RoleCompletionPayloadV5:
                package = repository.load_role_invocation(payload)
                round_packages.append(package)
                packages.append(package)
            elif type(payload) is RoundOutcomePayloadV5:
                authority = payload.authority
                round_outcomes.append(
                    {
                        "round_index": payload.round_index,
                        "outcome": payload.outcome,
                        "authority_type": type(authority).__name__,
                        "stage": getattr(authority, "stage", None),
                        "failure_code": getattr(authority, "failure_code", None),
                        "role": getattr(authority, "role", None),
                    }
                )
        rounds.append(
            {
                "round_index": round_index,
                "package_count": len(round_packages),
                "roles": [package.call.role for package in round_packages],
                "outcomes": [package.attempt.outcome for package in round_packages],
                "usage": [
                    {
                        "external_attempt_count": package.attempt.usage.external_attempt_count,
                        "input_tokens": package.attempt.usage.input_tokens,
                        "output_tokens": package.attempt.usage.output_tokens,
                        "total_tokens": package.attempt.usage.total_tokens,
                        "cost_usd": str(package.attempt.usage.cost_usd),
                        "returned_model": package.attempt.usage.returned_model,
                    }
                    for package in round_packages
                ],
                "package_sha256": [package.sha256 for package in round_packages],
            }
        )
    identity = _role_ledger_read_identity_v5(
        repository,
        manifest,
        api_key_environment_variable=config.api_key_environment_variable,
    )
    authenticate_paid_role_history_v5(
        repository=repository,
        manifest=manifest,
        adapter_config=config,
        packages=tuple(packages),
    )
    evidence = {
        "archive_root": PROVIDER.relative_to(ROOT).as_posix(),
        "manifest_ref": {
            "relative_path": manifest_ref.relative_path,
            "sha256": manifest_ref.sha256,
        },
        "original_adapter_config_ref": {
            "relative_path": launch.adapter_config_ref.relative_path,
            "sha256": launch.adapter_config_ref.sha256,
        },
        "package_count": len(packages),
        "all_ledger_terminal_authority": all(
            type(package.terminal_authority) is LedgerRoleTerminalAuthorityV5 for package in packages
        ),
        "identity_matches_original_config": {
            "campaign_manifest": identity.campaign_manifest_sha256 == config.campaign_manifest_sha256,
            "repository_root": repository.root_identity_sha256 == config.repository_root_identity_sha256,
            "audit_store": identity.audit_store_identity_sha256 == config.audit_store_identity_sha256,
            "ledger": identity.ledger_identity_sha256 == config.ledger_identity_sha256,
            "gateway": identity.gateway_identity_sha256 == config.gateway_identity_sha256,
        },
        "rounds": rounds,
        "round_outcomes": round_outcomes,
        "aggregate_paid_usage": {
            "external_attempt_count": sum(package.attempt.usage.external_attempt_count for package in packages),
            "total_tokens": sum(package.attempt.usage.total_tokens for package in packages),
            "cost_usd": str(sum((package.attempt.usage.cost_usd for package in packages), start=__import__("decimal").Decimal("0"))),
        },
    }
    evidence["pass"] = (
        len(packages) == 2
        and evidence["all_ledger_terminal_authority"]
        and all(evidence["identity_matches_original_config"].values())
    )
    write_json("h3b-actual-auth-results.json", evidence)
    print(json.dumps(evidence, indent=2, sort_keys=True))
    if not evidence["pass"]:
        raise SystemExit(1)


def verification_outputs() -> None:
    relative = SOURCE.relative_to(ROOT).as_posix()
    checked = subprocess.run(
        [sys.executable, "-B", "-m", "ruff", "check", relative],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    ruff_output = checked.stdout + checked.stderr
    (PACKAGE / "h3b-ruff.txt").write_text(ruff_output, encoding="utf-8")
    if checked.returncode:
        raise SystemExit(checked.returncode)
    raw = SOURCE.read_bytes()
    compile(raw, str(SOURCE), "exec")
    (PACKAGE / "h3b-compile.txt").write_text("Python 3.13 in-memory compile passed\n", encoding="utf-8")
    diff_raw = (PACKAGE / "h3b-source.diff").read_bytes()
    added = [
        line
        for line in diff_raw.decode("utf-8").splitlines()
        if line.startswith("+") and not line.startswith("+++")
    ]
    trailing = [line for line in added if line.rstrip(" \t") != line]
    checks = {
        "diff_sha256": digest(diff_raw),
        "added_lines_with_trailing_whitespace": len(trailing),
        "preimage_has_final_crlf": PREIMAGE.read_bytes().endswith(b"\r\n"),
        "source_has_final_crlf": raw.endswith(b"\r\n"),
        "ruff_exit_code": checked.returncode,
        "in_memory_compile": "passed",
    }
    (PACKAGE / "h3b-diff-check.txt").write_text(
        json.dumps(checks, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    print(json.dumps(checks, indent=2, sort_keys=True))
    if trailing or not checks["preimage_has_final_crlf"] or not checks["source_has_final_crlf"]:
        raise SystemExit(1)


if __name__ == "__main__":
    if len(sys.argv) != 2:
        raise SystemExit("usage: h3b_evidence.py before|static|auth|after|preservation|verify")
    mode = sys.argv[1]
    if mode == "before":
        before()
    elif mode == "static":
        static()
    elif mode == "auth":
        authenticate_actual()
    elif mode == "after":
        snapshots("after")
    elif mode == "preservation":
        preservation()
    elif mode == "verify":
        verification_outputs()
    else:
        raise SystemExit("unknown evidence mode")
