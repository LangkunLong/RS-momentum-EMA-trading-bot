+        ),
+    }
+
+
+def _unsupported_request_fields(
+    simulator: _SimulatorPolicy,
+) -> dict[str, dict[str, object]]:
+    unsupported = PolicyClassification.ADVISORY_OR_UNSUPPORTED
+    return {
+        "min_rs_score": _field(
+            simulator.min_rs_score,
+            unsupported,
+            "core.canslim.entry_contract.MIN_RS_SCORE",
