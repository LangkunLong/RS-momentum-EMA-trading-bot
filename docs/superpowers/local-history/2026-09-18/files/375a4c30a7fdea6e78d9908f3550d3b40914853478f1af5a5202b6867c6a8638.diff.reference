+def _require_docker_host_path_v5(path: str) -> str:
+    if (
+        type(path) is not str
+        or not path
+        or path.strip() != path
+        or not ntpath.isabs(path)
+        or ntpath.normpath(path) != path
+        or any(character in path for character in {",", "\x00", "\n", "\r"})
+    ):
+        raise ValueError("historical Docker host mount path is invalid")
+    return path
+
