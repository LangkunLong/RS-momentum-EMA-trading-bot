 def snapshot_files(root: Path) -> dict[str, str]:
-    return {
-        path.relative_to(root).as_posix(): digest(path.read_bytes())
-        for path in sorted(root.rglob("*"))
-        if path.is_file()
-    }
+    result = {}
+    pending = [root]
+    while pending:
+        directory = pending.pop()
+        entries = sorted(os.scandir(windows_extended_path(directory)), key=lambda item: item.name)
+        for entry in entries:
+            logical = directory / entry.name
+            metadata = path_lstat(logical)
+            if is_reparse(logical):
+                raise RuntimeError(f"snapshot contains a link or reparse point: {logical}")
+            if stat.S_ISDIR(metadata.st_mode):
+                pending.append(logical)
+            elif stat.S_ISREG(metadata.st_mode):
+                result[logical.relative_to(root).as_posix()] = digest(
+                    read_regular_link_free(logical, "snapshot file")
+                )
+            else:
+                raise RuntimeError(f"snapshot contains a non-regular entry: {logical}")
+    return dict(sorted(result.items()))
+
+
+def directory_names(path: Path) -> tuple[str, ...]:
+    return tuple(sorted(entry.name for entry in os.scandir(windows_extended_path(path))))
 
 
