+def windows_extended_path(path: Path) -> str | Path:
+    if os.name != "nt":
+        return path
+    value = str(path)
+    if value.startswith("\\\\?\\"):
+        return value
+    if value.startswith("\\\\"):
+        return "\\\\?\\UNC\\" + value[2:]
+    return "\\\\?\\" + value
+
+
+def path_lstat(path: Path) -> os.stat_result:
+    return os.lstat(windows_extended_path(path))
+
+
+def path_exists(path: Path) -> bool:
+    try:
+        path_lstat(path)
+    except FileNotFoundError:
+        return False
+    return True
+
+
+def metadata_identity(metadata: os.stat_result) -> tuple[int, int]:
+    return metadata.st_dev, metadata.st_ino
+
+
+def read_regular_link_free(path: Path, label: str) -> bytes:
+    try:
+        before = path_lstat(path)
+        attributes = getattr(before, "st_file_attributes", 0)
+        if not stat.S_ISREG(before.st_mode) or stat.S_ISLNK(before.st_mode) or attributes & _REPARSE_POINT:
+            raise RuntimeError(f"{label} is not a regular link-free file: {path}")
+        descriptor = os.open(
+            windows_extended_path(path),
+            os.O_RDONLY | getattr(os, "O_BINARY", 0),
+        )
+        try:
+            opened = os.fstat(descriptor)
+            if not stat.S_ISREG(opened.st_mode) or metadata_identity(opened) != metadata_identity(before):
+                raise RuntimeError(f"{label} changed while opening: {path}")
+            chunks = []
+            while chunk := os.read(descriptor, 1024 * 1024):
+                chunks.append(chunk)
+        finally:
+            os.close(descriptor)
+        after = path_lstat(path)
+        if metadata_identity(after) != metadata_identity(before):
+            raise RuntimeError(f"{label} changed while reading: {path}")
+        return b"".join(chunks)
+    except RuntimeError:
+        raise
+    except OSError as exc:
+        raise RuntimeError(f"{label} is unavailable: {path}") from exc
+
+
