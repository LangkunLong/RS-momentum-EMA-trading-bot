+        monotonic=lambda: 1.0,
+    )
+    second = gateway.freeze_pit_optimizer_pricing(
+        model="deepseek/deepseek-r1",
+        wall_deadline=10.0,
+        monotonic=lambda: 2.0,
+    )
+
+    assert first is second
+    assert pricing_calls == ["deepseek/deepseek-r1"]
+
+
