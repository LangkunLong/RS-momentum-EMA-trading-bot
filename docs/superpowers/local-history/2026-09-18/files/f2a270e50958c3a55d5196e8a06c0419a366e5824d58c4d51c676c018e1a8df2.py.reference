SOURCE_TEXTS = {
    "core/strategy_policy/entry.py": (
        "def evaluate_entry(snapshot):\n"
        "    return None\n"
    ),
    "core/strategy_policy/risk.py": (
        "def recommend_capacity(snapshot):\n"
