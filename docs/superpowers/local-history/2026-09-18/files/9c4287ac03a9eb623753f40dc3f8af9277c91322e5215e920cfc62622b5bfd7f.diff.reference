diff --git a/core/canslim/a_annual_earnings.py b/core/canslim/a_annual_earnings.py
index a70bc1c..663bb33 100644
--- a/core/canslim/a_annual_earnings.py
+++ b/core/canslim/a_annual_earnings.py
@@ -41,21 +41,22 @@ def _safe_growth(current: float, previous: float) -> Optional[float]:
 
     if np.isclose(previous, 0.0):
         return None
 
     # Reject negative prior-period earnings — transitioning from a loss
     # to a profit produces misleading growth percentages for CANSLIM.
     if previous < 0:
         return None
 
     try:
-        return (current - previous) / abs(previous)
+        growth = (current - previous) / abs(previous)
+        return growth if np.isfinite(growth) else None
     except ZeroDivisionError:
         return None
 
 
 def _find_earnings_row(df: pd.DataFrame) -> Optional[str]:
     """Find the best earnings row label using fuzzy matching.
 
     Priority:
         1. Basic EPS or Diluted EPS
         2. Net Income (fallback)
