"""Inspect an actual owned container through its original concrete adapter."""
import argparse
import json
from pathlib import Path
import sys
sys.path.insert(0, str(Path.cwd()))
from core.pit_optimizer_v5.artifacts import LocalArtifactRepositoryV5
from core.pit_optimizer_v5.contracts import ArtifactRefV5
from core.pit_optimizer_v5.development_preparation import DevelopmentRoundFactoryV5, load_development_config_v5
from core.pit_optimizer_v5.manifest import authenticate_campaign_manifest_v5
from core.pit_optimizer_v5.operations import _authorities

parser = argparse.ArgumentParser()
parser.add_argument('--root', type=Path, required=True)
parser.add_argument('--command', required=True)
parser.add_argument('--receipt', required=True)
args = parser.parse_args()
root = args.root.resolve()
saved = json.loads((root / 'campaign-launch-input.json').read_text())
repository = LocalArtifactRepositoryV5(root)
manifest_ref = ArtifactRefV5(**saved['manifest_ref'])
authorities = _authorities(authenticate_campaign_manifest_v5(repository=repository, manifest_ref=manifest_ref))
reference = ArtifactRefV5(**saved['adapter_config_ref'])
config = load_development_config_v5(repository, authorities, reference)
factory = DevelopmentRoundFactoryV5(adapter_config_ref=reference, adapter_config=config)
composed = factory.compose_round(repository=repository, authorities=authorities, round_index=1,
                                owner_token_sha256=saved['owner_token_sha256'], adapter_config=config)
executor = composed.dependencies.candidates.panel_evaluator.evaluator.executor
reservation = executor._load_reservation(args.command, repair=False)
identity = executor._container_identity(args.command, repair=False)
assert reservation is not None and identity is not None
with executor._pinned_control_transaction(reservation) as transaction:
    image = executor._inspect_image(transaction)
    inspection = executor._inspect_container(transaction=transaction, reservation=reservation,
                image_authority=image, container_id=identity.container_id,
                allowed_statuses=('created', 'running', 'exited'))
    assert inspection is not None
    executor._require_stable_container_identity(identity, inspection)
    receipt = {'container_id': identity.container_id, 'command_sha256': args.command,
               'stable_identity_verified': True, 'state': inspection.state_authority,
               'state_attestation_sha256': inspection.state_attestation_sha256}
with (root / args.receipt).open('x') as stream:
    json.dump(receipt, stream, indent=2)
print(json.dumps(receipt))
