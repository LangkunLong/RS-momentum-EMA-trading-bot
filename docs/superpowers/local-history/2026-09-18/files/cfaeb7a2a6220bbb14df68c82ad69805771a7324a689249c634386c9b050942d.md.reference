+@contextmanager
+def _authenticated_bundle_copy(source: _SealedSource) -> Iterator[Path]:
+    """Yield a private immutable-by-construction copy of one authenticated bundle.
+
+    SQLite never receives the manifest pathname.  The source is copied through a
+    descriptor bound to the checked lexical path, the copied bytes are hashed,
+    and only the unshared random temporary pathname is passed to ``PITDataBundle``.
+    Mutating or replacing the original after this point cannot affect lazy reads.
+    """
+
+    digest = hashlib.sha256()
+    copied_path: Path | None = None
+    workspace_parent = Path(os.path.abspath(Path(__file__))).parents[2]
+    workspace_metadata = _nonreparse_path_metadata(
+        workspace_parent, "trusted Task 11 workspace temp parent"
+    )
+    if not stat.S_ISDIR(workspace_metadata.st_mode):
+        raise ValueError("trusted Task 11 workspace temp parent must be a directory")
+    try:
+        with tempfile.NamedTemporaryFile(
+            mode="w+b",
+            prefix=".task11-ca-provenance-",
+            suffix=".sqlite3",
+            dir=workspace_parent,
+            delete=False,
+        ) as output_handle:
+            copied_path = Path(output_handle.name)
+            with _bound_regular_input(
+                source.path, f"sealed Task 11 {source.name}"
+            ) as input_handle:
+                while block := input_handle.read(1024 * 1024):
+                    digest.update(block)
+                    output_handle.write(block)
+                output_handle.flush()
+                os.fsync(output_handle.fileno())
+        if digest.hexdigest() != source.expected_sha256:
+            raise ValueError(f"sealed Task 11 {source.name} changed before copying")
+        _regular_nonreparse_file(
+            copied_path, "authenticated temporary Task 11 PIT bundle"
+        )
+        # Keep a bound guard descriptor open for the entire SQLite lifetime. On
+        # platforms that allow replacement of an open file, the post-yield
+        # identity/stability check fails before any payload can be returned.
+        with _bound_regular_input(
+            copied_path, "authenticated temporary Task 11 PIT bundle"
+        ):
+            yield copied_path
+    except OSError as exc:
+        raise ValueError("sealed Task 11 PIT bundle cannot be copied") from exc
+    finally:
+        if copied_path is not None and copied_path.exists():
+            if copied_path.parent != workspace_parent:
+                raise ValueError("temporary Task 11 bundle cleanup escaped its parent")
+            _regular_nonreparse_file(
+                copied_path, "temporary Task 11 bundle cleanup file"
+            )
+            copied_path.unlink()
+
+
