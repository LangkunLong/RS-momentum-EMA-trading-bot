+        budget_state = self.ledger._pit_optimizer_recovery_state(
+            run_manifest_sha256=lifecycle.authorization_lease.run_manifest_sha256,
+            audit_run_id=self.audit_trail.run_id,
+        )
+        candidate = (
+            response_processed,
+            facts,
+            usage,
+            payload_sha256,
