+          authorization_lease=lease,
+          frozen_pricing=pricing,
+          wall_deadline=10.0,
+          monotonic=lambda: 1.0,
+      )
+
+      assert pricing.lookup_status == "unavailable"
+      assert len(client.completions.calls) == 1
+      assert result.facts.cost_usd == pytest.approx(250.0)
+  ```
