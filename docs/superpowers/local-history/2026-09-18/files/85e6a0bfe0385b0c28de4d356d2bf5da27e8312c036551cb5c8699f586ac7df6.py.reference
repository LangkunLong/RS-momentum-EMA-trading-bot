"""Acquire four documented FMP index sources locally; never print/store credentials."""

from datetime import datetime, timezone
import hashlib
import json
from pathlib import Path
import re
import urllib.error
import urllib.request


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def main():
    secret_file = Path(r"C:\Projects\trading_bot\RS-momentum-EMA-trading-bot\.env")
    secret = None
    for line in secret_file.read_text(encoding="utf-8-sig").splitlines():
        match = re.match(r"\s*FMP_API_KEY\s*=\s*(.*?)\s*$", line)
        if match:
            secret = match[1].strip().strip('"').strip("'")
    if not secret:
        raise SystemExit("FMP key unavailable")
    opener = urllib.request.build_opener(NoRedirect())
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    output = Path.cwd() / ".artifacts/pit-optimizer-v5/data/acquisition/raw/fmp" / stamp
    output.mkdir(parents=True, exist_ok=False)
    records = []
    for endpoint in (
        "sp500-constituent",
        "historical-sp500-constituent",
        "nasdaq-constituent",
        "historical-nasdaq-constituent",
    ):
        url = "https://financialmodelingprep.com/stable/" + endpoint
        request = urllib.request.Request(
            url,
            headers={"apikey": secret, "Accept": "application/json", "User-Agent": "PIT-V5-Local-Data-Acquisition/1.0"},
        )
        record = {"endpoint": endpoint, "url": url, "retrieved_at_utc": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")}
        try:
            with opener.open(request, timeout=30) as response:
                raw = response.read(16_777_217)
                record["http_status"] = response.status
            if len(raw) > 16_777_216 or secret.encode() in raw:
                raise ValueError("response failed bounded secret-free check")
            value = json.loads(raw)
            if not isinstance(value, list) or not value or not all(isinstance(item, dict) for item in value):
                record["status"] = "unexpected_response_shape"
            else:
                with (output / (endpoint + ".json")).open("xb") as stream:
                    stream.write(raw)
                record.update(status="downloaded", bytes=len(raw), sha256=hashlib.sha256(raw).hexdigest(), rows=len(value), field_names=sorted(set().union(*(set(item) for item in value))))
                for field in ("date", "dateAdded"):
                    dates = sorted({item[field][:10] for item in value if isinstance(item.get(field), str) and re.match(r"^\d{4}-\d{2}-\d{2}", item[field])})
                    if dates:
                        record[field + "_range"] = [dates[0], dates[-1]]
        except urllib.error.HTTPError as error:
            record.update(status="http_error", http_status=error.code)
        except Exception as error:
            record.update(status="transport_or_shape_failure", error_type=type(error).__name__)
        records.append(record)
        print(json.dumps({key: value for key, value in record.items() if key not in {"url", "sha256", "retrieved_at_utc"}}, sort_keys=True), flush=True)
    manifest = {"schema_version": 1, "purpose": "raw_acquisition_only_not_v5_admitted_inputs", "source": "FMP authenticated API", "credential_persisted": False, "requests": records}
    with (output / "acquisition.json").open("x", encoding="utf-8") as stream:
        json.dump(manifest, stream, sort_keys=True, indent=2)
        stream.write("\n")
    print("Acquisition directory:", output)
    return 0 if all(item["status"] == "downloaded" for item in records) else 2


if __name__ == "__main__":
    raise SystemExit(main())
