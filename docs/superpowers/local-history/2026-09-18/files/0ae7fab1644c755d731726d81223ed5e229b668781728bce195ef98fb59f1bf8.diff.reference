+    budget.reconcile_pit_optimizer(
+        budget_reservation,
+        usage,
+        request_started=True,
+    )
+    snapshot = agent_loop.BudgetSnapshot(
+        api_calls=1,
+        prompt_tokens=100,
+        completion_tokens=50,
+        total_tokens=150,
+        reserved_tokens=150,
+        reserved_usd=0.001,
+        spent_usd=0.001,
+        authoritative_usd=0.001,
+        retained_reservation_usd=0.0,
+        retained_reservation_tokens=0,
