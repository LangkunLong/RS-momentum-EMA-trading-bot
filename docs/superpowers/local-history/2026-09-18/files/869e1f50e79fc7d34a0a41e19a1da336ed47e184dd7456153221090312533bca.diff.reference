         "effective_policy_sha256": "d" * 64,
     }
     primitive = {
-        "fold_id": fold_id,
+        "fold_id": fold.fold_id,
         "transactions": [asdict(transaction)],
         "entry_outcomes": [asdict(outcome)],
-        "equity": [asdict(fields["equity"][0])],
