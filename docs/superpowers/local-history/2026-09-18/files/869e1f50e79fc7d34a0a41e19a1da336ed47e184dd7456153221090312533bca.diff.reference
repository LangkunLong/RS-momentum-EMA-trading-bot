+    funnel = (AggregateMetric("entries_executed", 1),)
+    equity_points = tuple(
+        ParityEquityPoint(session, equity)
+        for session in (equity_sessions or fold.sessions)
+    )
     fields = {
-        "fold_id": fold_id,
+        "fold_id": fold.fold_id,
