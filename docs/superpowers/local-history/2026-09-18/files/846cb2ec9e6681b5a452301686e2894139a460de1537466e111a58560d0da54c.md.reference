Command:

```powershell
@'
import pandas as pd

from core.canslim.a_annual_earnings import evaluate_a, evaluate_a_with_trace
from core.canslim.c_current_earnings import evaluate_c, evaluate_c_with_trace
from core.canslim.earnings_trace import PIT_PUBLIC_DATES_ATTR, MetricFamily, TraceReason

duplicate_a = pd.DataFrame(
    [[1.0, 2.0], [1.0, 2.0]],
    index=["Diluted EPS", "Diluted EPS"],
    columns=pd.to_datetime(["2023-12-31", "2024-12-31"]),
)
assert evaluate_a(duplicate_a) == (0.0, None, None)
fy_a = pd.DataFrame([[1.0, 2.0]], index=["Diluted EPS"], columns=["FY2023", "FY2024"])
assert evaluate_a(fy_a) == (0.8, 1.0, None)

unmatched_c = pd.DataFrame(
    [[2.0]], index=["Diluted EPS"], columns=pd.to_datetime(["2025-06-30"])
)
unmatched_c.attrs[PIT_PUBLIC_DATES_ATTR] = {"2025-06-30": "2025-08-01"}
c_trace = evaluate_c_with_trace(unmatched_c)
assert c_trace.metric_family is MetricFamily.DILUTED_EPS
assert c_trace.terminal_reason is TraceReason.NO_COMPARABLE_PRIOR_PERIOD
assert str(c_trace.current_period_end) == "2025-06-30"
assert str(c_trace.current_public_date) == "2025-08-01"
assert c_trace.current_value == 2.0
missing_c = unmatched_c.copy()
missing_c.attrs[PIT_PUBLIC_DATES_ATTR] = {}
try:
    evaluate_c_with_trace(missing_c)
except ValueError:
    pass
else:
    raise AssertionError("unmatched C accepted missing selected-period provenance")
baseline_c = unmatched_c.copy()
baseline_c.attrs = {}
assert evaluate_c(missing_c) == evaluate_c(baseline_c)

one_a = pd.DataFrame(
    [[2.0]], index=["Diluted EPS"], columns=pd.to_datetime(["2024-12-31"])
)
one_a.attrs[PIT_PUBLIC_DATES_ATTR] = {"2024-12-31": "2025-02-01"}
a_trace = evaluate_a_with_trace(one_a)
assert a_trace.metric_family is MetricFamily.DILUTED_EPS
assert a_trace.terminal_reason is TraceReason.INSUFFICIENT_ANNUAL_HISTORY
assert str(a_trace.current_period_end) == "2024-12-31"
assert str(a_trace.current_public_date) == "2025-02-01"
assert a_trace.current_value == 2.0
missing_a = one_a.copy()
missing_a.attrs[PIT_PUBLIC_DATES_ATTR] = {}
try:
    evaluate_a_with_trace(missing_a)
except ValueError:
    pass
else:
    raise AssertionError("one-observation A accepted missing selected-period provenance")
baseline_a = one_a.copy()
baseline_a.attrs = {}
assert evaluate_a(missing_a) == evaluate_a(baseline_a)
print("Task 1 fix round 1 probe: PASS")
'@ | python -B -
```

Output:

```text
Task 1 fix round 1 probe: PASS
```

Exit code 0.

### Self-review

- The only A calculation performed before the shared score path is the legacy
  `sort_index().dropna()` expression; duplicate rows are no longer collapsed.
- Scalar mode does not call `_period_end` or PIT lookup helpers, preserving
  legacy behavior for non-date labels and optional metadata.
- Strict trace mode validates visible incomplete observations before their early
  returns. No test file was created or run.
