# Keep real credentials only in an untracked .env file or your secret store.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_STOCK_FEED=iex

FMP_API_KEY=
FMP_PLAN=free
# May be lowered, but free mode hard-caps this value at 198 requests per window.
FMP_DAILY_REQUEST_BUDGET=198

# Required only by agent_loop.py. Set one name; if both are set they must match.
OPENROUTER_API_KEY=
# OPENROUTER=

# Optional execution and notification settings; uncomment only when configured.
# EXECUTION_STORE_DB_PATH=.artifacts/execution/execution_workflows.sqlite3
# NOTIFY_EMAIL_PROVIDER=gmail_oauth
# NOTIFY_EMAIL_FROM=
# NOTIFY_EMAIL_TO=
# Legacy SMTP-only fallback. Gmail OAuth does not use or require this value.
# NOTIFY_EMAIL_PASSWORD=
