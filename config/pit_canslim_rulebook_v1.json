{
  "version": "pit-canslim-v1",
  "sources": {
    "IBD20": {"title": "IBD 20 Rules for Investment Success", "url": "https://shop.investors.com/images/promotional/20-Rules_102808.pdf", "source_location": "CANSLIM rules"},
    "MS2023": {"title": "MarketSmith 2023 Q4 selling-strategy guide", "url": "https://marketsurge-files.investors.com/2023/12/StockGuide-Q4-2023.pdf", "source_location": "Selling strategy"},
    "IBDTS2020": {"title": "IBD Top Stocks 2020", "url": "https://shop.investors.com/images/promotional/shop/assets/pdf/TopStocks-2020.pdf", "source_location": "Follow-through days"},
    "MS2024": {"title": "MarketSmith 2024 market-exposure guide", "url": "https://marketsurge-files.investors.com/2024/07/StockGuide-Mid-year-2024.pdf", "source_location": "Market exposure"},
    "FFTY": {"title": "Innovator IBD 50 investor guide", "url": "https://www.innovatoretfs.com/pdf/ffty_investor_guide.pdf", "source_location": "CANSLIM domains"}
  },
  "rules": {
    "C.EPS_YOY": {"letter_or_domain":"C","requirement":"Recent quarterly EPS growth meets the cited CANSLIM floor","classification":"required","observability":"pit_observed","parameter_policy":{"growth_floor":0.25},"source_id":"IBD20","source_location":"C/current earnings","implementation_status":"implemented"},
    "C.SALES_YOY": {"letter_or_domain":"C","requirement":"Recent quarterly sales growth confirms current growth","classification":"required","observability":"pit_observed","parameter_policy":{"growth_floor":0.25},"source_id":"IBD20","source_location":"C/current earnings","implementation_status":"implemented"},
    "C.ACCELERATION": {"letter_or_domain":"C","requirement":"Recent quarterly earnings or sales acceleration is evaluated","classification":"allowed_variant","observability":"pit_observed","parameter_policy":{},"source_id":"IBD20","source_location":"C/current earnings","implementation_status":"partial"},
    "A.EPS_MULTIYEAR": {"letter_or_domain":"A","requirement":"Annual earnings growth is persistent over the cited multi-year window","classification":"required","observability":"pit_observed","parameter_policy":{"growth_floor":0.25},"source_id":"IBD20","source_location":"A/annual earnings","implementation_status":"implemented"},
    "A.ROE": {"letter_or_domain":"A","requirement":"Return on equity quality is evaluated when the cited rule requires it","classification":"required","observability":"pit_observed","parameter_policy":{},"source_id":"FFTY","source_location":"Annual earnings quality","implementation_status":"partial"},
    "N.NEWNESS": {"letter_or_domain":"N","requirement":"At least one cited form of newness passes","classification":"required","observability":"pit_observed","parameter_policy":{},"source_id":"IBD20","source_location":"N/new products or price highs","implementation_status":"partial","satisfaction_logic":"one_of:N.CATALYST,N.NEW_HIGH"},
    "N.CATALYST": {"letter_or_domain":"N","requirement":"A new business catalyst exists","classification":"allowed_variant","observability":"pit_unavailable","parameter_policy":{},"source_id":"IBD20","source_location":"N/new products","implementation_status":"unimplemented"},
    "N.NEW_HIGH": {"letter_or_domain":"N","requirement":"Price breaks to a new high from a properly formed base","classification":"allowed_variant","observability":"pit_observed","parameter_policy":{},"source_id":"IBD20","source_location":"N/new highs from bases","implementation_status":"unimplemented"},
    "S.VOLUME_CONFIRMATION": {"letter_or_domain":"S","requirement":"Breakout demand is confirmed by price and volume","classification":"required","observability":"pit_observed","parameter_policy":{"volume_ratio":1.3},"source_id":"IBD20","source_location":"S/supply and demand","implementation_status":"implemented"},
    "S.SUPPLY": {"letter_or_domain":"S","requirement":"Share supply and accumulation/distribution evidence are evaluated","classification":"allowed_variant","observability":"pit_observed","parameter_policy":{},"source_id":"IBD20","source_location":"S/supply","implementation_status":"partial"},
    "L.RS": {"letter_or_domain":"L","requirement":"Relative-strength leadership meets the cited threshold","classification":"required","observability":"pit_observed","parameter_policy":{"floor":80},"source_id":"FFTY","source_location":"L/relative strength","implementation_status":"implemented"},
    "L.INDUSTRY_GROUP": {"letter_or_domain":"L","requirement":"The stock belongs to a leading industry group","classification":"required","observability":"pit_observed","parameter_policy":{},"source_id":"FFTY","source_location":"L/industry leadership","implementation_status":"partial"},
    "I.SPONSORSHIP": {"letter_or_domain":"I","requirement":"Quality institutional sponsorship is present and increasing","classification":"required","observability":"pit_unavailable","parameter_policy":{},"source_id":"FFTY","source_location":"I/institutional sponsorship","implementation_status":"unimplemented"},
    "M.CONFIRMED_UPTREND": {"letter_or_domain":"M","requirement":"New purchases require a confirmed market uptrend","classification":"required","observability":"pit_observed","parameter_policy":{},"source_id":"IBDTS2020","source_location":"Follow-through day","implementation_status":"implemented"},
    "M.DISTRIBUTION_EXPOSURE": {"letter_or_domain":"M","requirement":"Distribution evidence reduces exposure or blocks new risk","classification":"required","observability":"pit_observed","parameter_policy":{},"source_id":"MS2024","source_location":"Market exposure","implementation_status":"implemented"},
    "E.PROPER_BASE": {"letter_or_domain":"E","requirement":"Entry comes from a recognized objectively encoded base","classification":"required","observability":"pit_observed","parameter_policy":{},"source_id":"IBD20","source_location":"Entry/base construction","implementation_status":"unimplemented"},
    "E.PIVOT": {"letter_or_domain":"E","requirement":"The buy point is derived from the proper base","classification":"required","observability":"pit_observed","parameter_policy":{},"source_id":"IBD20","source_location":"Entry/pivot","implementation_status":"unimplemented"},
    "E.BUY_ZONE": {"letter_or_domain":"E","requirement":"Entry is no more than 5% above the pivot","classification":"required","observability":"pit_observed","parameter_policy":{"maximum_extension":0.05},"source_id":"IBD20","source_location":"Buy zone","implementation_status":"implemented"},
    "E.NEXT_OPEN": {"letter_or_domain":"E","requirement":"Execution uses the exact next market-session open without lookahead","classification":"required","observability":"pit_observed","parameter_policy":{},"source_id":"MS2024","source_location":"Execution timing","implementation_status":"implemented"},
    "X.LOSS_LIMIT": {"letter_or_domain":"X","requirement":"Losses are cut no later than 7-8% below purchase price","classification":"required","observability":"pit_observed","parameter_policy":{"maximum_loss":0.08},"source_id":"MS2023","source_location":"Selling strategy/losses","implementation_status":"implemented"},
    "X.PROFIT_ZONE": {"letter_or_domain":"X","requirement":"The normal 20-25% profit zone is evaluated","classification":"required","observability":"pit_observed","parameter_policy":{"normal_profit_zone":[0.2,0.25]},"source_id":"MS2023","source_location":"Selling strategy/profit zone","implementation_status":"partial"},
    "X.EIGHT_WEEK_HOLD": {"letter_or_domain":"X","requirement":"Fast 20% advances receive the cited eight-week hold treatment","classification":"required","observability":"pit_observed","parameter_policy":{"fast_gain": [0.2,15,40]},"source_id":"MS2023","source_location":"Selling strategy/eight-week hold","implementation_status":"partial"},
    "X.STRUCTURAL_SELL": {"letter_or_domain":"X","requirement":"Moving-average or distribution sell rules use cited CANSLIM behavior","classification":"allowed_variant","observability":"pit_observed","parameter_policy":{},"source_id":"MS2023","source_location":"Selling strategy/structural sell","implementation_status":"partial"}
  }
}
