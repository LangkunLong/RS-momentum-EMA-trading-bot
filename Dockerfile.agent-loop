FROM python:3.13.14-slim@sha256:9662417aace5ae7b8e2609cce472b72a8958e134ba372808abe9cc1a0c0125e6

ARG AGENT_UID=65532
ARG AGENT_GID=65532

RUN groupadd --gid "${AGENT_GID}" agent-loop \
    && useradd --uid "${AGENT_UID}" --gid "${AGENT_GID}" --no-create-home --home-dir /nonexistent agent-loop

WORKDIR /opt/agent-loop
COPY --chown=65532:65532 requirements-lock.txt /opt/agent-loop/requirements-lock.txt
RUN python -m pip install --no-cache-dir --requirement /opt/agent-loop/requirements-lock.txt

USER 65532:65532
WORKDIR /workspace
ENTRYPOINT ["python"]
